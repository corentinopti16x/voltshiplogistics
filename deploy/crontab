# Airtable push + reconcile. Shopify sync is nightly; order webhooks cover the gap.
*/10 * * * * . /etc/cron.env && /usr/local/bin/run-sync-jobs.sh airtable >> /proc/1/fd/1 2>&1
15 2 * * * . /etc/cron.env && /usr/local/bin/run-sync-jobs.sh shopify >> /proc/1/fd/1 2>&1
*/15 * * * * . /etc/cron.env && /usr/local/bin/run-sync-jobs.sh eccang >> /proc/1/fd/1 2>&1
*/10 * * * * . /etc/cron.env && /usr/local/bin/run-sync-jobs.sh support >> /proc/1/fd/1 2>&1
