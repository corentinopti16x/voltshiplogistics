# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Never prefix with NEXT_PUBLIC_.
# Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Required in production: protects /api/cron/*
CRON_SECRET=

# Airtable (server-only)
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_PRODUCTS_TABLE=PRODUCTS
# Set true when the Client column is the client name, not a linked record.
AIRTABLE_CLIENT_AS_NAME=true
AIRTABLE_WEBHOOK_SECRET=
# Optional JSON map from app keys to Airtable field names.
# ECDF PRODUCTS example:
# {"title":"Product name","lifecycleStatus":"Lifecycle","sourcingStatus":"Sourcing status","weightG":"Unit weight (g)","shippingChannel":"Shipping category","productionLeadDays":"Production lead time (days)","clientPrice":"Client price (USD)","sellingPrice":"Selling price (USD)","factoryPurchasePrice":"Factory price (RMB) [INTERNAL]","supplierName":"Supplier name [INTERNAL]","supplierContact":"Supplier contact [INTERNAL]","sourcingLocation":"Sourcing location [INTERNAL]","internalNotes":"Notes"}
AIRTABLE_PRODUCT_FIELDS_JSON=

# n8n / notification callbacks (server-only)
N8N_RESEARCH_WEBHOOK_URL=
N8N_NOTIFICATION_WEBHOOK_URL=
N8N_SHARED_SECRET=

# Shopify OAuth (public app: any client connects their own store from Settings).
# Client ID / secret from the Shopify Partner / Dev dashboard app.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated access scopes requested at install. Must match the scopes declared on
# the Shopify app. Products + orders + fulfillment orders + fulfillments + inventory +
# locations + shipping + returns:
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_fulfillments,write_fulfillments,read_inventory,write_inventory,read_locations,read_shipping,read_returns,write_returns
# AES-256-GCM key for stored access tokens (32-byte key as 64 hex chars)
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_API_VERSION=2026-07
# Public origin of this app. The Shopify app's allowed redirect URL must be exactly
# `${NEXT_PUBLIC_APP_URL}/api/shopify/callback` (prod: https://app.voltshiplogistics.com/api/shopify/callback).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate assistant ("Mettre à jour les tarifs") — server-only.
# Without ANTHROPIC_API_KEY the import actions return "Assistant tarifs non configuré".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ECCANG WMS (server-only). One appKey/appToken PER CLIENT is stored encrypted on the
# client (admin → client → "Entrepôt (ECCANG)"); there is no global key.
# Host of the OMS, e.g. wms.example.com or http://wms.example.com (SOAP endpoint
# /default/svc/web-service is appended). No sandbox: ECCANG creates a test customer in live.
ECCANG_API_HOST=
# Shared secret in the callback URL registered in ECCANG:
#   https://app.voltshiplogistics.com/api/webhooks/eccang?token=<ECCANG_WEBHOOK_SECRET>
ECCANG_WEBHOOK_SECRET=
# Optional: AES-256-GCM key (64 hex chars) for the stored appTokens.
# Falls back to SHOPIFY_TOKEN_ENCRYPTION_KEY when empty.
ECCANG_TOKEN_ENCRYPTION_KEY=

# SAV Lite (Gmail) + public tracking API — server-only.
# Google Cloud OAuth client (Web application). Authorized redirect URI must be exactly
# `${NEXT_PUBLIC_APP_URL}/api/support/gmail/callback`. Scope: gmail.modify. See README "SAV & API publique".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: AES-256-GCM key (64 hex chars) for the stored Gmail refresh tokens.
# Falls back to SHOPIFY_TOKEN_ENCRYPTION_KEY when empty.
SUPPORT_TOKEN_ENCRYPTION_KEY=
# The public tracking API (/api/public/v1) needs no extra env: keys are created per client
# in Settings → "API & intégrations SAV". AI drafts use ANTHROPIC_API_KEY above (optional).
